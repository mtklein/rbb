builddir = out

cc = clang -O1
cc = clang -fsanitize=address,integer,undefined -fno-sanitize-recover=all

warn = -Weverything $
       -Wno-declaration-after-statement $
       -Wno-implicit-void-ptr-cast $
       -Wno-poison-system-directories $
       -Wno-switch-default

rule compile
    command = ccache $cc -g -fcolor-diagnostics -Werror $warn -MD -MF $out.d -c $in -o $out
    depfile = $out.d
    deps    = gcc

rule link
    command = ccache $cc $in -o $out

rule run
    command = ./$in > $out

build out/rbb.o:   compile  rbb.c
build out/test.o:  compile  test.c
build out/test:    link out/test.o out/rbb.o
build out/test.ok: run  out/test
