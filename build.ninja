builddir = out

opt = clang -O1
dbg = clang -g -fsanitize=address,integer,undefined -fno-sanitize-recover=all

warn = -Weverything $
       -Wno-declaration-after-statement $
       -Wno-implicit-void-ptr-cast $
       -Wno-poison-system-directories $
       -Wno-switch-default

rule compile
    command = ccache $cc -fcolor-diagnostics -Werror $warn -MD -MF $out.d -c $in -o $out
    depfile = $out.d
    deps    = gcc

rule link
    command = ccache $cc $in -o $out

rule run
    command = ./$in > $out

build out/dbg/rbb.o: compile rbb.c
    cc = $dbg
build out/opt/rbb.o: compile rbb.c
    cc = $opt

build out/dbg/test.o: compile test.c
    cc = $dbg
build out/opt/test.o: compile test.c
    cc = $opt

build out/dbg/test: link out/dbg/test.o out/dbg/rbb.o
    cc = $dbg
build out/opt/test: link out/opt/test.o out/opt/rbb.o
    cc = $opt

build out/dbg/test.ok: run out/dbg/test
build out/opt/test.ok: run out/opt/test
